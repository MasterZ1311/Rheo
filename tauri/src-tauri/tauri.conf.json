{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rheo",
  "version": "0.1.0",
  "identifier": "sh.rheo.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": "v1Compatible",
    "externalBin": ["binaries/rheo-server", "binaries/rheo-mcp"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "11.0",
      "infoPlist": "Info.plist",
      "entitlements": "Entitlements.plist"
    },
    "resources": {
      "gen/Assets.car": "./",
      "gen/partial.plist": "./"
    }
  },
  "app": {
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self' tauri: asset: http://localhost:14000 ws://localhost:14000; script-src 'self' 'unsafe-eval' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: tauri: blob:; media-src 'self' asset: tauri: blob: http://localhost:14000; connect-src 'self' http://localhost:14000 ws://localhost:14000 http://localhost:5173 ws://localhost:5173 https://api.rheo.sh https://rheo.sh https://github.com",
      "capabilities": ["default"]
    },
    "windows": [
      {
        "title": "Rheo",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "devtools": true,
        "userAgent": null,
        "titleBarStyle": "Overlay"
      }
    ],
    "withGlobalTauri": false
  },
  "plugins": {
    "shell": {
      "open": ".*"
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUxRENBQkRBQjdBNTM1OTIKUldTU05hVzMycXZjNGJGcUxmcVVocll2QjdSaTJNdlFxR2M3VDJsMnVvbDdyZGRPMmRlOW9aWTcK",
      "endpoints": ["https://github.com/MasterZ1311/Rheo/releases/latest/download/latest.json"]
    }
  }
}
