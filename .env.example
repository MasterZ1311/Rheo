# Rheo Server Configuration
# Copy this file to .env or configure your process environment variables.

# Network & Server Binding
RHEO_HOST=127.0.0.1
RHEO_PORT=17493

# Security & Access Control
# Optional API key required for non-loopback requests to administrative endpoints (/shutdown, /watchdog/disable, /models/migrate)
# RHEO_API_KEY=your-secure-random-secret-key-here

# Allowed Hosts for Host Header validation (comma-separated).
# Default includes localhost, 127.0.0.1, [::1], tauri.localhost
# RHEO_ALLOWED_HOSTS=localhost,127.0.0.1

# Additional CORS Origins (comma-separated).
# Default includes local dev servers (Vite, Next.js, Tauri).
# RHEO_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate Limiting (requests per minute on /generate, /transcribe, /llm/generate)
# RHEO_RATE_LIMIT_PER_MINUTE=60

# Storage & Model Cache
# Custom directory for HuggingFace model weights. If unset, defaults to system default cache.
# RHEO_MODELS_DIR=/path/to/models/cache
# RHEO_DATA_DIR=/path/to/rheo/data

# Cloud & Sync Service Endpoints
# RHEO_CLOUD_URL=https://rheo.sh
# RHEO_CLOUD_API_URL=https://api.rheo.sh

# Hardware & Acceleration
# Variant override: cpu, cuda, or rocm. Autodetected if unset.
# RHEO_BACKEND_VARIANT=cpu

# ROCm GPU Tuning (Linux / AMD Windows)
# HSA_OVERRIDE_GFX_VERSION=10.3.0
# MIOPEN_LOG_LEVEL=4

# MCP (Model Context Protocol) Client ID
# RHEO_CLIENT_ID=rheo-desktop

# Debugging & Offline Settings
# RHEO_OFFLINE_PATCH=1
# RHEO_SMOKE_TEST=0

